<Window x:Class="Thinksnap.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thinksnap Settings"
        Width="820"
        Height="700"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Icon="Assets/extension_icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#9CC8FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F4F7FB" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#F4F7FB" />
                                <Setter Property="Foreground" Value="#111418" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#1F2934" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
        </Style>
        <Style x:Key="RailButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,9,12,9" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="AccentMark"
                                        Width="4"
                                        Margin="8,9,0,9"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="2"
                                        Opacity="0" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#263140" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="AccentMark" Property="Opacity" Value="0.75" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="AccentMark" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F4F7FB" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#F4F7FB" />
                                <Setter TargetName="AccentMark" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="AccentMark" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#111418" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#F4F7FB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#F4F7FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#1F2934" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0,34,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True" />
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False" />
                            <Path Data="M 0 0 L 5 5 L 10 0"
                                  Width="10"
                                  Height="6"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,13,0"
                                  Stroke="{DynamicResource PrimaryTextBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Opacity="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#111820"
                                            BorderBrush="{DynamicResource BorderBrushColor}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4">
                                        <ScrollViewer CanContentScroll="True"
                                                      SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#263140" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#111820" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#526173" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Settings"
                       FontSize="30"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText"
                       Text="Changes are saved automatically."
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="13" />
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,20,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="12"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    VerticalAlignment="Stretch">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="GeneralCategoryButton" Content="General" Tag="{Binding ElementName=GeneralSection}" Click="CategoryButton_Click" Style="{StaticResource RailButtonStyle}" />
                        <Button x:Name="ShortcutsCategoryButton" Content="Shortcuts" Tag="{Binding ElementName=ShortcutsSection}" Click="CategoryButton_Click" Style="{StaticResource RailButtonStyle}" />
                        <Button x:Name="CaptureCategoryButton" Content="Capture" Tag="{Binding ElementName=CaptureSection}" Click="CategoryButton_Click" Style="{StaticResource RailButtonStyle}" />
                        <Button x:Name="InterfaceCategoryButton" Content="Interface" Tag="{Binding ElementName=InterfaceSection}" Click="CategoryButton_Click" Style="{StaticResource RailButtonStyle}" />
                        <Button x:Name="EditorCategoryButton" Content="Editor" Tag="{Binding ElementName=EditorSection}" Click="CategoryButton_Click" Style="{StaticResource RailButtonStyle}" />
                        <Button x:Name="SaveCategoryButton" Content="Save / Clipboard" Tag="{Binding ElementName=SaveSection}" Click="CategoryButton_Click" Style="{StaticResource RailButtonStyle}" />
                        <Button x:Name="UpdatesCategoryButton" Content="Updates" Tag="{Binding ElementName=UpdatesSection}" Click="CategoryButton_Click" Style="{StaticResource RailButtonStyle}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom"
                            Content="Reset all"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,14,0,0"
                            Click="ResetAllSettings_Click" />
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="SettingsScrollViewer"
                          Grid.Column="1"
                          Margin="16,0,0,0"
                          Padding="0,0,12,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border x:Name="GeneralSection" Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="General"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Startup and shell behavior."
                                       Margin="0,6,0,8"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <CheckBox x:Name="FloatingCaptureButtonCheckBox"
                                      Content="Show floating capture button"
                                      Checked="FloatingCaptureButtonCheckBox_Changed"
                                      Unchecked="FloatingCaptureButtonCheckBox_Changed" />
                            <CheckBox x:Name="MinimizeToTrayCheckBox"
                                      Content="Keep running in tray when the taskbar window is closed"
                                      Checked="MinimizeToTrayCheckBox_Changed"
                                      Unchecked="MinimizeToTrayCheckBox_Changed" />
                            <Button Content="Reset capture button position"
                                    Width="220"
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ResetCaptureButtonPosition_Click" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ShortcutsSection" Style="{StaticResource SectionBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Shortcuts"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Global capture shortcut."
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock x:Name="HotkeyDisplayText"
                                           Margin="0,14,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="HotkeyRecordButton"
                                        Content="Record"
                                        MinWidth="96"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        PreviewKeyDown="HotkeyRecordButton_PreviewKeyDown"
                                        Click="HotkeyRecordButton_Click" />
                                <Button Content="Reset"
                                        MinWidth="88"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="HotkeyResetButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="CaptureSection" Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Capture"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Frozen overlay and selection behavior."
                                       Margin="0,6,0,8"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock x:Name="CaptureDelayValueText"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Slider x:Name="CaptureDelaySlider"
                                    Minimum="0"
                                    Maximum="1000"
                                    TickFrequency="50"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="CaptureDelaySlider_ValueChanged" />
                            <TextBlock x:Name="OverlayDimValueText"
                                       Margin="0,14,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Slider x:Name="OverlayDimSlider"
                                    Minimum="20"
                                    Maximum="85"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="OverlayDimSlider_ValueChanged" />
                            <CheckBox x:Name="SelectionInstructionsCheckBox"
                                      Content="Show selection instruction hint"
                                      Checked="SelectionInstructionsCheckBox_Changed"
                                      Unchecked="SelectionInstructionsCheckBox_Changed" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="InterfaceSection" Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Interface"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Theme, accent, and control sizing."
                                       Margin="0,6,0,8"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="Theme preset"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <ComboBox x:Name="ThemePresetBox"
                                      Margin="0,8,0,0"
                                      Height="34"
                                      SelectionChanged="ThemePresetBox_SelectionChanged">
                                <ComboBoxItem Content="Midnight" />
                                <ComboBoxItem Content="Graphite" />
                                <ComboBoxItem Content="Aurora" />
                            </ComboBox>

                            <TextBlock Text="Accent"
                                       Margin="0,16,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Tag="#2F80ED" Style="{StaticResource SwatchButtonStyle}" Click="AccentButton_Click" Background="#2F80ED" />
                                <Button Tag="#22C55E" Style="{StaticResource SwatchButtonStyle}" Click="AccentButton_Click" Background="#22C55E" />
                                <Button Tag="#F97316" Style="{StaticResource SwatchButtonStyle}" Click="AccentButton_Click" Background="#F97316" />
                                <Button Tag="#E11D48" Style="{StaticResource SwatchButtonStyle}" Click="AccentButton_Click" Background="#E11D48" />
                                <Button Tag="#A855F7" Style="{StaticResource SwatchButtonStyle}" Click="AccentButton_Click" Background="#A855F7" />
                            </WrapPanel>

                            <TextBlock x:Name="CaptureButtonSizeValueText"
                                       Margin="0,14,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Slider x:Name="CaptureButtonSizeSlider"
                                    Minimum="42"
                                    Maximum="72"
                                    TickFrequency="2"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="CaptureButtonSizeSlider_ValueChanged" />

                            <TextBlock x:Name="ToolbarButtonSizeValueText"
                                       Margin="0,14,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Slider x:Name="ToolbarButtonSizeSlider"
                                    Minimum="36"
                                    Maximum="56"
                                    TickFrequency="2"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="ToolbarButtonSizeSlider_ValueChanged" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="EditorSection" Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Editor"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Defaults used when a new overlay editor opens."
                                       Margin="0,6,0,8"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="Default redaction mode"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <ComboBox x:Name="DefaultRedactionBox"
                                      Margin="0,8,0,0"
                                      Height="34"
                                      SelectionChanged="DefaultRedactionBox_SelectionChanged">
                                <ComboBoxItem Content="Pixelate" />
                                <ComboBoxItem Content="Blackout" />
                                <ComboBoxItem Content="Blur" />
                            </ComboBox>
                            <TextBlock x:Name="StrokeThicknessValueText"
                                       Margin="0,14,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Slider x:Name="StrokeThicknessSlider"
                                    Minimum="1"
                                    Maximum="12"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="StrokeThicknessSlider_ValueChanged" />
                            <TextBlock x:Name="TextFontSizeValueText"
                                       Margin="0,14,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Slider x:Name="TextFontSizeSlider"
                                    Minimum="10"
                                    Maximum="72"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="TextFontSizeSlider_ValueChanged" />
                            <CheckBox x:Name="TextMoveHandlesCheckBox"
                                      Content="Show text move handles"
                                      Checked="TextMoveHandlesCheckBox_Changed"
                                      Unchecked="TextMoveHandlesCheckBox_Changed" />
                            <CheckBox x:Name="TextBoldCheckBox"
                                      Content="Create new text as bold"
                                      Checked="TextBoldCheckBox_Changed"
                                      Unchecked="TextBoldCheckBox_Changed" />
                            <TextBlock Text="Default text alignment"
                                       Margin="0,16,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <ComboBox x:Name="TextAlignmentBox"
                                      Margin="0,8,0,0"
                                      Height="34"
                                      SelectionChanged="TextAlignmentBox_SelectionChanged">
                                <ComboBoxItem Content="Left" />
                                <ComboBoxItem Content="Center" />
                                <ComboBoxItem Content="Right" />
                            </ComboBox>
                            <TextBlock Text="Text color"
                                       Margin="0,16,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Tag="#ff0000" Style="{StaticResource SwatchButtonStyle}" Click="TextColorButton_Click" Background="#ff0000" />
                                <Button Tag="#ffffff" Style="{StaticResource SwatchButtonStyle}" Click="TextColorButton_Click" Background="#ffffff" />
                                <Button Tag="#22C55E" Style="{StaticResource SwatchButtonStyle}" Click="TextColorButton_Click" Background="#22C55E" />
                                <Button Tag="#F97316" Style="{StaticResource SwatchButtonStyle}" Click="TextColorButton_Click" Background="#F97316" />
                            </WrapPanel>
                            <CheckBox x:Name="TextBackgroundCheckBox"
                                      Content="Create new text with background"
                                      Checked="TextBackgroundCheckBox_Changed"
                                      Unchecked="TextBackgroundCheckBox_Changed" />
                            <TextBlock Text="Text background color"
                                       Margin="0,16,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Tag="#d2000000" Style="{StaticResource SwatchButtonStyle}" Click="TextBackgroundColorButton_Click" Background="#d2000000" />
                                <Button Tag="#d2ffffff" Style="{StaticResource SwatchButtonStyle}" Click="TextBackgroundColorButton_Click" Background="#d2ffffff" />
                                <Button Tag="#d2ff0000" Style="{StaticResource SwatchButtonStyle}" Click="TextBackgroundColorButton_Click" Background="#d2ff0000" />
                                <Button Tag="#d22F80ED" Style="{StaticResource SwatchButtonStyle}" Click="TextBackgroundColorButton_Click" Background="#d22F80ED" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SaveSection" Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Save / Clipboard"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Output defaults."
                                       Margin="0,6,0,8"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="Filename pattern"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBox x:Name="FileNamePatternBox"
                                     Height="34"
                                     Margin="0,8,0,0"
                                     TextChanged="FileNamePatternBox_TextChanged" />
                            <CheckBox x:Name="CopyAfterSaveCheckBox"
                                      Content="Copy image after saving"
                                      Checked="CopyAfterSaveCheckBox_Changed"
                                      Unchecked="CopyAfterSaveCheckBox_Changed" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="UpdatesSection" Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Updates"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Open the latest Thinksnap release page."
                                       Margin="0,6,0,8"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Button Content="Güncelleştirmeleri al..."
                                    Width="210"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OpenUpdatesButton_Click" />
                            <TextBlock Text="Update URL"
                                       Margin="0,16,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBox x:Name="UpdateUrlBox"
                                     Height="34"
                                     Margin="0,8,0,0"
                                     TextChanged="UpdateUrlBox_TextChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Close"
                    MinWidth="92"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
