<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Thinksnap</AssemblyName>
    <RootNamespace>Thinksnap.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\extension_icon.ico</ApplicationIcon>
    <Version>0.1.2</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\extension_icon.ico" />
    <Resource Include="Assets\extension_icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thinksnap.Core\Thinksnap.Core.csproj" />
  </ItemGroup>
</Project>
