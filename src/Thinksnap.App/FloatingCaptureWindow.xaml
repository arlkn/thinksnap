<Window x:Class="Thinksnap.App.FloatingCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="54"
        Height="54"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Icon="Assets/extension_icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="IconOnlyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="Transparent"
            CornerRadius="27"
            Opacity="0.98">
        <Button ToolTip="Capture"
                Style="{StaticResource IconOnlyButtonStyle}"
                Cursor="SizeAll"
                PreviewMouseLeftButtonDown="CaptureButton_PreviewMouseLeftButtonDown"
                PreviewMouseMove="CaptureButton_PreviewMouseMove"
                PreviewMouseLeftButtonUp="CaptureButton_PreviewMouseLeftButtonUp">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Take Screenshot"
                              Click="TakeScreenshotMenuItem_Click" />
                    <MenuItem Header="Settings..."
                              Click="OpenSettingsMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="Hide capture button"
                              Click="HideCaptureButtonMenuItem_Click" />
                </ContextMenu>
            </Button.ContextMenu>
            <Image x:Name="CaptureIconImage"
                   Width="54"
                   Height="54"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True">
                <Image.Source>
                    <BitmapImage UriSource="Assets/extension_icon.png"
                                 DecodePixelWidth="512" />
                </Image.Source>
            </Image>
        </Button>
    </Border>
</Window>
