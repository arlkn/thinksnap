<Window x:Class="Thinksnap.App.DetachedEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Thinksnap.App.Controls"
        Title="Thinksnap Editor"
        Width="900"
        Height="620"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/extension_icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Margin="16"
                Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Viewbox Stretch="Uniform"
                     StretchDirection="Both">
                <controls:AnnotationCanvas x:Name="CanvasHost" />
            </Viewbox>
        </Border>

        <Border Grid.Row="1"
                Margin="0,0,0,16"
                Padding="10"
                HorizontalAlignment="Center"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1"
                CornerRadius="22">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PixelateButton" Content="Px" ToolTip="Pixelate" Click="PixelateButton_Click" />
                <Button x:Name="BlackoutButton" Content="Blk" ToolTip="Blackout" Click="BlackoutButton_Click" />
                <Button x:Name="BlurButton" Content="Blur" ToolTip="Soft blur redaction" Click="BlurButton_Click" />
                <Separator Margin="8,0" />
                <Button x:Name="ArrowButton" Content="Arr" ToolTip="Arrow" Click="ArrowButton_Click" />
                <Button x:Name="LineButton" Content="Line" ToolTip="Line" Click="LineButton_Click" />
                <Button x:Name="RectangleButton" Content="Rect" ToolTip="Rectangle" Click="RectangleButton_Click" />
                <Button x:Name="PenButton" Content="Pen" ToolTip="Pen" Click="PenButton_Click" />
                <Button x:Name="TextButton" Content="Text" ToolTip="Text" Click="TextButton_Click" />
                <Separator Margin="8,0" />
                <Button x:Name="UndoButton" Content="Undo" ToolTip="Undo" Click="UndoButton_Click" />
                <Button x:Name="CopyButton" Content="Copy" ToolTip="Copy to clipboard" Click="CopyButton_Click" />
                <Button x:Name="SaveButton" Content="Save" ToolTip="Save PNG" Click="SaveButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
