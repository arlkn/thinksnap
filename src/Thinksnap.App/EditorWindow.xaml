<Window x:Class="Thinksnap.App.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Thinksnap.App.Controls"
        Title="Thinksnap Editor"
        Width="1000"
        Height="700"
        MinWidth="720"
        MinHeight="480">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Pixelate" Click="PixelateButton_Click" />
                <Button Content="Arrow" Click="ArrowButton_Click" />
                <Button Content="Line" Click="LineButton_Click" />
                <Button Content="Rectangle" Click="RectangleButton_Click" />
                <Button Content="Pen" Click="PenButton_Click" />
                <Button Content="Text" Click="TextButton_Click" />
                <Separator />
                <Button Content="Undo" Click="UndoButton_Click" />
                <Separator />
                <Button Content="Copy" Click="CopyButton_Click" />
                <Button Content="Save" Click="SaveButton_Click" />
            </ToolBar>
        </ToolBarTray>

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#2b2b2b">
            <controls:AnnotationCanvas x:Name="CanvasHost" />
        </ScrollViewer>
    </DockPanel>
</Window>
