<Application x:Class="Thinksnap.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111418" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#181D24" />
        <SolidColorBrush x:Key="BorderBrushColor" Color="#303844" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9DA7B3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F80ED" />
        <Color x:Key="AccentColorValue">#2F80ED</Color>
    </Application.Resources>
</Application>
