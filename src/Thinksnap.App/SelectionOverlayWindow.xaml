<Window x:Class="Thinksnap.App.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Thinksnap.App.Controls"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Canvas x:Name="OverlayCanvas"
                Background="#66000000"
                MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
                MouseMove="OverlayCanvas_MouseMove"
                MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp">
            <Rectangle x:Name="SelectionRectangle"
                       Visibility="Collapsed"
                       Stroke="#FFFFFFFF"
                       StrokeThickness="2"
                       StrokeDashArray="4 2"
                       Fill="#22FFFFFF" />
        </Canvas>

        <Grid x:Name="EditorLayer"
              Visibility="Collapsed"
              Background="#D9111418">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="32"
                    Background="#101318"
                    BorderBrush="#303844"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Viewbox Stretch="Uniform"
                         StretchDirection="Both"
                         Margin="18">
                    <controls:AnnotationCanvas x:Name="CanvasHost" />
                </Viewbox>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,0,0,28"
                    Padding="10"
                    HorizontalAlignment="Center"
                    Background="#F0181D24"
                    BorderBrush="#34404D"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PixelateButton" Content="Px" ToolTip="Pixelate" Click="PixelateButton_Click" />
                    <Button x:Name="ArrowButton" Content="↗" ToolTip="Arrow" Click="ArrowButton_Click" />
                    <Button x:Name="LineButton" Content="／" ToolTip="Line" Click="LineButton_Click" />
                    <Button x:Name="RectangleButton" Content="□" ToolTip="Rectangle" Click="RectangleButton_Click" />
                    <Button x:Name="PenButton" Content="✎" ToolTip="Pen" Click="PenButton_Click" />
                    <Button x:Name="TextButton" Content="T" ToolTip="Text" Click="TextButton_Click" />
                    <Separator Margin="8,0" />
                    <Button Content="↶" ToolTip="Undo" Click="UndoButton_Click" />
                    <Separator Margin="8,0" />
                    <Button Content="Copy" ToolTip="Copy to clipboard" Click="CopyButton_Click" />
                    <Button Content="Save" ToolTip="Save PNG" Click="SaveButton_Click" />
                    <Button Content="Cancel" ToolTip="Cancel" Click="CancelButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
